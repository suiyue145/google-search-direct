{
  "manifest_version": 3,
  "name": "Google 搜索直达",
  "version": "1.2.0",
  "description": "右键选中文字 → Google 搜索 → 按当前网站的优先列表自动打开结果；内置小说/影视/购物等网站包，快捷键一键切换",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "*://www.google.com/*"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google 搜索直达 - 点击切换网站包"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "switch-pack-1": { "suggested_key": { "default": "Alt+Shift+1" }, "description": "切换到网站包 1" },
    "switch-pack-2": { "suggested_key": { "default": "Alt+Shift+2" }, "description": "切换到网站包 2" },
    "switch-pack-3": { "suggested_key": { "default": "Alt+Shift+3" }, "description": "切换到网站包 3" },
    "switch-pack-4": { "suggested_key": { "default": "Alt+Shift+4" }, "description": "切换到网站包 4" },
    "switch-pack-5": { "suggested_key": { "default": "Alt+Shift+5" }, "description": "切换到网站包 5" },
    "switch-pack-6": { "suggested_key": { "default": "Alt+Shift+6" }, "description": "切换到网站包 6" },
    "switch-pack-7": { "suggested_key": { "default": "Alt+Shift+7" }, "description": "切换到网站包 7" },
    "switch-pack-8": { "suggested_key": { "default": "Alt+Shift+8" }, "description": "切换到网站包 8" },
    "cycle-pack": { "suggested_key": { "default": "Alt+Shift+0" }, "description": "循环切换到下一个网站包" }
  }
}
