{
  "manifest_version": 3,
  "name": "Google 搜索直达",
  "version": "1.0.0",
  "description": "右键选中文字 → Google 搜索 → 自动打开指定默认网站的结果链接",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "*://www.google.com/*"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
