{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "*://www.google.com/*"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "switch-pack-1": { "suggested_key": { "default": "Alt+Shift+1" }, "description": "__MSG_cmdSwitch1__" },
    "switch-pack-2": { "suggested_key": { "default": "Alt+Shift+2" }, "description": "__MSG_cmdSwitch2__" },
    "switch-pack-3": { "suggested_key": { "default": "Alt+Shift+3" }, "description": "__MSG_cmdSwitch3__" },
    "cycle-pack": { "suggested_key": { "default": "Alt+Shift+0" }, "description": "__MSG_cmdCycle__" },
    "switch-pack-4": { "description": "__MSG_cmdSwitch4__" },
    "switch-pack-5": { "description": "__MSG_cmdSwitch5__" },
    "switch-pack-6": { "description": "__MSG_cmdSwitch6__" },
    "switch-pack-7": { "description": "__MSG_cmdSwitch7__" },
    "switch-pack-8": { "description": "__MSG_cmdSwitch8__" }
  }
}
